{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "electron/*.mjs",
    "vite.config.ts",
    "electron/preload.cjs",
    "shared",
    "scripts/e2e-harness.mjs",
    "scripts/generate-preload.mjs",
    "scripts/checksums.mjs",
    "scripts/dev.mjs",
    "scripts/start.mjs",
    "tests/contracts.ts",
    "tests/e2e",
    "playwright.config.ts"
  ]
}
