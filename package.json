{
  "name": "savehub",
  "version": "1.1.0",
  "private": true,
  "description": "SaveHub · 珍藏每一次冒险。跨平台游戏存档管理器。",
  "author": "SaveHub",
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "test:interactions": "node scripts/interactions.mjs",
    "test:portable": "node scripts/portable-smoke.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "build": "tsc --noEmit && vite build",
    "pack:win": "tsc --noEmit && vite build && electron-builder --win --x64 --dir",
    "dist:win": "tsc --noEmit && vite build && electron-builder --win --x64",
    "dist:mac": "tsc --noEmit && vite build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.savehub.desktop",
    "productName": "SaveHub",
    "asar": true,
    "directories": { "output": "release/1.1.0" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.png", "package.json"],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "SaveHub-${version}-Windows-x64-portable.exe" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true
    }
  }
}
